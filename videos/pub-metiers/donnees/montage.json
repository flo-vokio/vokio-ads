   ],
   "texte": "Plombier, coiffeur, garagiste, dentiste, restaurant…"
  },
  {
   "nom": "v1",
   "type": "voix",
   "film": [
    4.0,
    6.647
   ],
   "texte": "Quand vous ne pouvez pas décrocher, c'est Vokio qui répond."
  },
  {
   "nom": "v2",
   "type": "voix",
   "film": [
    7.0,
    9.74
   ],
   "texte": "Vokio prend le rendez-vous dans votre agenda Google."
  },
  {
   "nom": "v3",
   "type": "voix",
   "film": [
    10.5,
    12.497
   ],
   "texte": "Confirme par SMS, et rappelle la veille."
  },
  {
   "nom": "v4",
   "type": "voix",
   "film": [
    13.0,
    14.115
   ],
   "texte": "Prend les commandes."
  },
  {
   "nom": "v5",
   "type": "voix",
   "film": [
    14.5,
    16.822
   ],
   "texte": "Gère les urgences, même à vingt-trois heures."
  },
  {
   "nom": "v6",
   "type": "voix",
   "film": [
    17.5,
    20.519
   ],
   "texte": "Et chaque appel vous attend, résumé, dans votre espace."
  },
  {
   "nom": "v7",
   "type": "voix",
   "film": [
    21.0,
    22.533
   ],
   "texte": "Vokio parle votre métier."
  },
  {
   "nom": "v8",
   "type": "voix",
   "film": [
    25.55,
    28.661
   ],
   "texte": "Vokio. Votre ligne répond, même quand vous ne pouvez pas."
  },
  {
   "nom": "v9",
   "type": "voix",
   "film": [
    28.961,
    31.887
   ],
   "texte": "Créez votre espace gratuitement, sur vokio point F R."
  }
 ],
