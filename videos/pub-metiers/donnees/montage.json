   "film": [
    0.08,
    4.257
   ],
   "texte": "Plombier, coiffeur, garagiste, dentiste, restaurant…"
  },
  {
   "nom": "v1",
   "type": "voix",
   "film": [
    5.0,
    7.806
   ],
   "texte": "Quand vous ne pouvez pas décrocher, c'est Vokio qui répond."
  },
  {
   "nom": "v2",
   "type": "voix",
   "film": [
    8.5,
    10.657
   ],
   "texte": "Il prend le rendez-vous dans votre agenda,"
  },
  {
   "nom": "v3",
   "type": "voix",
   "film": [
    10.757,
    14.086
   ],
   "texte": "le confirme par SMS, et notifie votre client la veille."
  },
  {
   "nom": "v4",
   "type": "voix",
   "film": [
    14.306,
    15.823
   ],
   "texte": "Il prend aussi les commandes,"
  },
  {
   "nom": "v5",
   "type": "voix",
   "film": [
    15.923,
    18.231
   ],
   "texte": "gère les urgences même à vingt-trois heures,"
  },
  {
   "nom": "v6",
   "type": "voix",
   "film": [
    18.331,
    21.79
   ],
   "texte": "et chaque appel vous attend, résumé, dans votre espace."
  },
  {
   "nom": "v7",
   "type": "voix",
   "film": [
    22.5,
    24.331
   ],
   "texte": "Vokio parle votre métier."
  },
  {
   "nom": "v8",
   "type": "voix",
   "film": [
    27.05,
    30.497
   ],
   "texte": "Vokio. Votre ligne répond même quand vous ne pouvez pas."
  },
  {
   "nom": "v9",
   "type": "voix",
   "film": [
    30.797,
    32.935
   ],
   "texte": "Créez votre espace gratuitement."
  }
 ],
