node_modules/
.npm/
# Sorties de rendu : lourdes, reconstruites par `bin/hf render`
videos/*/renders/
videos/*/snapshots/
videos/*/.hyperframes/frame-packets/
# Médias générés (voix off provisoire, musique déposée par Florian)
videos/*/.media/
# Caches
.DS_Store
*.log
videos/*/capture/
# Essais de voix : régénérables en une commande (outils/voix.py --essai --sur)
essais/

# Prises d’essai par graine de la pub sonnerie : le choix est inscrit dans variantes.json
videos/vokio-sonnerie/assets/voix/graines/

# showcase : sons reconstruits par outils/ et son/mix.py (12 Mo chacun)
videos/showcase/son/*.wav
videos/showcase/son/stems/
videos/showcase/assets/son/*.wav
videos/showcase/son/cache/
videos/showcase/**/__pycache__/
videos/showcase/son/monde/*.wav

# showcase-iphone : même règles que showcase
videos/showcase-iphone/son/*.wav
videos/showcase-iphone/son/stems/
videos/showcase-iphone/assets/son/*.wav
videos/showcase-iphone/son/cache/
videos/showcase-iphone/son/riche-*/
videos/showcase-iphone/son/monde/*.wav
videos/showcase-iphone/**/__pycache__/
videos/showcase-iphone/snapshots/
videos/showcase-iphone/v1/
